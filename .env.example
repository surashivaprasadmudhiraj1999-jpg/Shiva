# ---------------------------------------------------------------------------
# Database (PostgreSQL with the pgvector extension enabled)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/ai_marketing_employee"

# ---------------------------------------------------------------------------
# Auth — Clerk (https://dashboard.clerk.com)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ---------------------------------------------------------------------------
# AI — Anthropic Claude (https://console.anthropic.com)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Embeddings — OpenAI (used for the pgvector-backed Knowledge memory, v2)
# ---------------------------------------------------------------------------
OPENAI_API_KEY="sk-..."

# ---------------------------------------------------------------------------
# Payments — Stripe (https://dashboard.stripe.com)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_GROWTH="price_..."
STRIPE_PRICE_AGENCY="price_..."

# ---------------------------------------------------------------------------
# Background jobs — Inngest (https://www.inngest.com)
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY="..."
INNGEST_SIGNING_KEY="..."

# ---------------------------------------------------------------------------
# Research — Exa / Firecrawl / Tavily (v2: live web research)
# ---------------------------------------------------------------------------
EXA_API_KEY=""
FIRECRAWL_API_KEY=""
TAVILY_API_KEY=""

# ---------------------------------------------------------------------------
# Monitoring & analytics
# ---------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
