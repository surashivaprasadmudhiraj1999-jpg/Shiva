# ─────────────────────────────────────────────────────────────
# SearchOS environment variables
# Copy this file to `.env.local` and fill in real values.
# The app runs fully on labelled DEMO DATA until these are set.
# NEVER commit real secrets. NEVER expose service keys to the client.
# ─────────────────────────────────────────────────────────────

# Supabase (auth, database, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Google integrations (server-side OAuth / API keys)
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GA4_PROPERTY_ID=
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=
PAGESPEED_INSIGHTS_API_KEY=

# Keyword data provider (DataForSEO or similar) — server-side only
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Notifications
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=
